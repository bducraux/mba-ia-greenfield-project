# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM='"StreamTube" <noreply@streamtube.com>'

# Queue (Redis — BullMQ broker)
REDIS_HOST=redis
REDIS_PORT=6379

# Object storage (S3 API — SeaweedFS in dev/test)
STORAGE_ENDPOINT=http://seaweedfs:8333
STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube-app
STORAGE_SECRET_KEY=streamtube-app-secret
STORAGE_BUCKET=streamtube-videos
STORAGE_THUMBNAILS_BUCKET=streamtube-thumbnails
STORAGE_FORCE_PATH_STYLE=true
STORAGE_CORS_ORIGIN=http://localhost:3001

# Object storage admin (dev only — used by storage-init to provision buckets)
STORAGE_ADMIN_ACCESS_KEY=streamtube-admin
STORAGE_ADMIN_SECRET_KEY=streamtube-admin-secret
